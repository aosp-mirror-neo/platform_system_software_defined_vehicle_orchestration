# proto-file: //system/software_defined_vehicle/core_services/service_bundles_registry/proto/sdv_service_bundles_manifest.proto
# proto-message: SdvServiceBundleManifestEntry

# SDV orchestration sample with Rust service bundle.
sdv_service_bundle_metadata {
  name: "OrchestratorSampleRustServiceBundle"
  version_number: 0
  version_name: "0.1 Alpha"
  native_library_path: "lib64/liboem_orchestrator_service_bundle_rust_sample.so"
  orchestration_config_path: "etc/config/orchestration/OrchestratorSampleRustServiceBundle.textproto"
}

# SDV orchestration sample with C++ service bundle.
sdv_service_bundle_metadata {
  name: "OrchestratorSampleCppServiceBundle"
  version_number: 0
  version_name: "0.1 Alpha"
  native_library_path: "lib64/liboem_orchestrator_service_bundle_cpp_sample.so"
  orchestration_config_path: "etc/config/orchestration/OrchestratorSampleCppServiceBundle.textproto"
  authorization_policy_path: "etc/config/permissions/OrchestratorSampleCppServiceBundle.textproto"
}

