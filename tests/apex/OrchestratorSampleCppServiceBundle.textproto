# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

instance: "test-instance"
instance: "custom-mode"
instance: "custom-mode-timestamp"
instance: "test-instance"
instance: "sample-main"
instance: "vehicle-main"
instance: "power-main"
instance: "sample-main-start-stop-destroy"
service_bundle_name: "OrchestratorSampleCppServiceBundle"
package_name: "com.sdv.google.sample.orch.apex"
custom_mode: "CHARGING"

state {
    condition {
        or {
            vehicle_state: "VEHICLE_ON"
        }
    }

    instances_states {
        started: "vehicle-main"
    }
}

state {
    condition {
        or {
            power_state: "ON"
        }
    }

    instances_states {
        started: "power-main"
    }
}

state {
    condition {
        or {
            custom_state {
                mode: "CHARGING"
                state: "ON"
            }
        }
    }

    instances_states {
        started: "custom-mode"
        started: "custom-mode-timestamp"
    }
}

state {
    condition {
        or {
            vehicle_state: "VEHICLE_ON"
        }
    }
    instances_states {
        started: "sample-main-start-stop-destroy"
    }
}

state {
    condition {
        or {
            vehicle_state: "PARK"
        }
    }
    instances_states {
        created: "sample-main-start-stop-destroy"
    }
}

state {
    condition {
        or {
            vehicle_state: "LOW_POWER"
        }
    }
    instances_states {
        destroyed: "sample-main-start-stop-destroy"
    }
}
