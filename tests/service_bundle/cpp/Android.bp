package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Sample of the orchestrator service bundle shared library written in C++.
cc_library_shared {
    name: "liboem_orchestrator_service_bundle_cpp_sample",
    srcs: [
        "src/sample_service.cpp",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libsdv_log",
        "libsdv_lifecycle_client_cpp",
        "libsdv_comms_cpp",
    ],

    product_specific: true,
}
