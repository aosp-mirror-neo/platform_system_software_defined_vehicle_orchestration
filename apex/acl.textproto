# proto-file: //system/software_defined_vehicle/middleware/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for Orchestrator Unit Types.

acls {
    name: "Public"
    include: "*"
}

acls {
    name: "Internal"
    include: "*:com.sdv.google.orchestrator.OrchestratorServiceBundle"
}

unit_types {
    name: "GlobalCustomStateChange"
    acl_names: "Internal"
}

service_units {
    name: "com-sdv-google-orchestrator-global-custom-state-change-unique"
    acl_names: "Internal"
}

unit_types {
    name: "CustomStateService"
    acl_names: "Internal"
}

service_units {
    name: "com-sdv-google-orchestrator-custom-state-service"
    acl_names: "Public"
}