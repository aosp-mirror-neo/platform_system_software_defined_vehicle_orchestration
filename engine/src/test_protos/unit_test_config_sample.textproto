# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

service_bundle_config {
  instance: "sample_instance"
  service_bundle_name: "sample_service_name"
  package_name: "com.android.sdv.samples"

  state {
    condition { power_state: "ON" }
    instances_states { started: "sample_instance" }
  }

  state {
    condition { custom_state { mode: "TEST" state: "start" } }
    instances_states { started: "sample_instance" }
  }

  state {
    condition { and { power_state: "ON" vehicle_state: "PARK" } }
    instances_states { started: "sample_instance" }
  }
}
