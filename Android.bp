package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "orchestration@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "sdv_orch",
    rustlibs: [
        "libsdv_log_rust",
        "liblog_rust",
        // Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-V2-rust",
        "google.sdv.lifecycle.crash-notification-aidl-rust",
        "google.sdv.lifecycle_manager-rust",
        "google.sdv.vpm-V1-rust",
        "google.sdv.orchestration-rust",
        "libbinder_rs",
        "libsdv_comms_rs",
        "libanyhow",
        "libsdv_dump",
        "libsdv_comms_ctx_impl",
        "libregex",
        "libcom_android_sdv_orchestrator_custom_state_service_rpc_rs",
        "libsdv_mw_rs_com_android_sdv_orchestrator_orchestrator_service_bundle",
        "libsdv_status_rs",
        "libmockall",
        "libsdv_orch_dist_config",
        "libcom_android_sdv_vpm_vpm_system_service_rpc_rs",
        "libfutures",
        "libsdv_mw_rs_sdv_comms",
        "liblazy_static",
        "libsdv_vpm_api",
        "libsdv_orch_api_stable",
        "libsdv_orch_dist_config_proto",
        "libsdv_mw_rs_comms",
        "libprotobuf",
        "librustutils",
        "libtokio_util",
        "libtokio",
        "libbinder_tokio_rs",
        "libdashmap",
        "libsdv_orchestration_common",
        "google.sdv.service_bundles_registry-V3-rust",
        "libpersistent_binder",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_library {
    name: "libsdv_orch_tests_common",
    defaults: ["sdv@rust_defaults"],
    srcs: [
        "tests/common/lib.rs",
    ],
    crate_name: "sdv_orch_tests_common",
    rustlibs: [
        "google.sdv.lifecycle_manager-rust",
        // Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-V2-rust",
        "libbinder_rs",
        "libsdv_status_rs",
        "libsdv_comms_rs",
        "libsdv_vpm_api",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_test {
    name: "sdv_core_core_services_integration_orch_vpm_tests",
    srcs: [
        "tests/orch_agent_vpm_integration_tests.rs",
    ],
    rustlibs: [
        "google.sdv.lifecycle_manager-rust",
        // Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-V2-rust",
        "libsdv_mw_rs_com_android_sdv_test_orchestrator_orch_test_service_bundle",
        "libsdv_vpm_api",
        "libnamed_lock",
        "libsdv_status_rs",
        "libsdv_comms_rs",
        "libcom_android_sdv_vpm_vpm_system_service_rpc_rs",
        "libsdv_orch_tests_common",
        "libtokio",
        "libsdv_mw_rs_test_sdv_vpm_vpm_system_client",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    auto_gen_config: true,
    test_config_template: ":sdv_authz_enforcement_flag_permissions_only_config_template",
    compile_multilib: "first",
    system_ext_specific: true,
    prefer_rlib: true,
    // Requires root so the test can perform Binder calls to the lifecycle manager
    require_root: true,
}

rust_test {
    name: "sdv_core_core_services_integration_orch_tests",
    srcs: [
        "tests/orch_agent_integration_tests.rs",
    ],
    rustlibs: [
        "google.sdv.orchestration-rust",
        "google.sdv.identity-V2-rust",
        "libsdv_mw_rs_com_android_sdv_test_orchestrator_orch_test_service_bundle",
        "libprotobuf",
        "libnamed_lock",
        "libbinder_rs",
        "libsdv_status_rs",
        "libsdv_comms_rs",
        "libsdv_orch_tests_common",
        "libtokio",
        "libcom_android_sdv_orchestrator_custom_state_service_rpc_rs",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_comms",
        "libsdv_orch_api_stable",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
    test_options: {
        unit_test: false,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    auto_gen_config: true,
    test_config_template: ":sdv_authz_enforcement_flag_permissions_only_config_template",
    compile_multilib: "first",
    system_ext_specific: true,
    prefer_rlib: true,
    // Requires root so the test can perform Binder calls to the lifecycle manager
    require_root: true,
}

rust_test {
    name: "sdv_core_core_services_integration_orch_initial_power_mode_test",
    srcs: [
        "tests/orch_agent_initial_power_state_test.rs",
    ],
    rustlibs: [
        "libsdv_orch_tests_common",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: false,
    },
    auto_gen_config: true,
    test_config_template: ":sdv_authz_enforcement_flag_permissions_only_config_template",
    compile_multilib: "first",
    system_ext_specific: true,
    prefer_rlib: true,
    // Requires root so the test can perform Binder calls to the lifecycle manager
    require_root: true,
}
