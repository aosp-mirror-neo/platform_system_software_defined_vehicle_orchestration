# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

package_name: "sdv.test.group"
service_bundle_name: "GroupConfigOnly"

instance: "left"
instance: "right"

group_mapping {
    group: "left_instances"
    instance: "left"
    # duplicated instance should not appear in config evaluation output
    instance: "left"
}

group_mapping {
    group: "right_instances"
    instance: "right"
}

group_mapping {
    group: "all_bundle_instances"
    instance: "left"
}

group_mapping {
    group: "all_bundle_instances"
    instance: "right"
    # undeclared instance should not appear in config evaluation output
    instance: "undeclared"
}