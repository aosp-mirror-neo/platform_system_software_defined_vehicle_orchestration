# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/vm_config.proto
# proto-message: VmConfig

service_bundle_config {
    package_name: "sdv.test"
    service_bundle_name: "TestBundle2"

    instance: "left"
    instance: "right"

    group_mapping {
        group: "left_instances"
        instance: "left"
    }

    group_mapping {
        group: "right_instances"
        instance: "right"
    }

    state {
        condition {
            power_state: "ON"
        }

        instances_states {
            started: "left"
            destroyed: "right"
        }
    }

    state {
        # default condition

        instances_states {
            created: "left"
            created: "right"
        }
    }
}

service_bundle_config {
    package_name: "sdv.test"
    service_bundle_name: "TestBundle1"

    instance: "left"
    instance: "right"

    group_mapping {
        group: "left_instances"
        instance: "left"
    }

    group_mapping {
        group: "right_instances"
        instance: "right"
    }

    state {
        # default condition

        instances_states {
            created: "left"
            created: "right"
        }
    }

    state {
        condition {
            power_state: "ON"
        }

        instances_states {
            # referencing undeclared instance is ignored
            started: "all"
        }
    }

    # state to check that complex condition can be defined
    state {
        condition {
            and {
                or {
                    vehicle_state: "LIFE_ON_BOARD"
                }
                vehicle_state: "UNKNOWN"
                not {
                    or {
                        power_state: "ON"
                        power_state: "POWER_OFF_EXIT"
                    }
                }
                custom_state {
                    mode: "Doors"
                    state: "OPEN"
                }
            }
        }

        # empty instances_states are allowed
        # (they don't affect the configuration though)
        instances_states {
        }
    }
}