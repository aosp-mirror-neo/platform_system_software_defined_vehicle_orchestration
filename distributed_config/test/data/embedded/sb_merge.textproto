# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/service_bundle_config.proto
# proto-message: ServiceBundleConfig

package_name: "sdv.test.embedded"
service_bundle_name: "MergeConfig"

custom_mode: "CHARGING"
custom_mode: "TIRE_PRESSURE"

retry_mapping {
  instance: "right"
  # Invalid instance name that should not be returned
  instance: "invalid"
  retry_config { max_retries: 3 }
}

instance: "left"
instance: "right"

group_mapping { group: "all_instances" instance: "left" instance: "right" }

state {
  # default condition

  instances_states { created: "left" started: "right" }
}