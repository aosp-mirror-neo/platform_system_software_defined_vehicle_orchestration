# proto-file: system/software_defined_vehicle/orchestration/src/distributed_config/protos/vm_config.proto
# proto-message: VmConfig

state {
  condition { custom_state { mode: "RightTest" state: "Create" } }

  groups_states { created: "right_instances" }
}

state {
  condition { custom_state { mode: "LeftTest" state: "Start" } }

  groups_states { started: "left_instances" }
}

state {
  condition { custom_state { mode: "DestroyTest" state: "AllInstances" } }

  groups_states { destroyed: "all_instances" }
}

service_bundle_config {
  package_name: "sdv.test.embedded"
  service_bundle_name: "MergeConfig"

  custom_mode: "CHARGING"
  custom_mode: "TIRE_PRESSURE"

  retry_mapping {
    instance: "left"
    retry_config { max_retries: 5 }
  }

  instance: "left"
  instance: "right"

  group_mapping { group: "left_instances" instance: "left" }

  group_mapping { group: "right_instances" instance: "right" }

  state {
    # default condition

    instances_states { created: "left" started: "right" }
  }
}