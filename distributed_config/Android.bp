package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libsdv_orch_dist_config_proto",
    crate_name: "sdv_orch_dist_config_proto",
    protos: ["src/protos/*.proto"],
    source_stem: "orch_dist_config_proto",
}

rust_defaults {
    name: "sdv_orch_dist_config_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "sdv_orch_dist_config",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libprotobuf",
        "libsdv_orch_dist_config_proto",
        "libanyhow",
        "liblog_rust",
        "libchrono",
        "libgoogletest_rust",
        "libserde",
        "libserde_json",
        "libsdv_orchestration_common",
        "libsdv_status_rs",
        "libsdv_vpm_api",
        "google.sdv.vpm-V1-rust",
        "libsdv_dump",
    ],
}

rust_library {
    name: "libsdv_orch_dist_config",
    defaults: ["sdv_orch_dist_config_defaults"],
}

rust_test {
    name: "sdv_core_core_services_unit_orch_dist_config_test",
    defaults: ["sdv_orch_dist_config_defaults"],
    rustlibs: [
        "libgoogletest_rust",
        "libregex",
        "libnamed_lock",
    ],
    auto_gen_config: true,
    // Needed for interacting with files (for persisting modes in tests).
    require_root: true,
    data: [
        "test/data/**/*.textproto",
    ],
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_options: {
        unit_test: true,
    },
}
