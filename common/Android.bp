rust_library {
    name: "libsdv_orchestration_common",
    defaults: ["sdv@rust_defaults"],
    crate_name: "sdv_orchestration_common",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        // Orchestrator uses ServiceFqin to communicate with Lifecycle manager API
        "google.sdv.identity-V2-rust",
        "google.sdv.vpm-V1-rust",
        "liblog_rust",
        "libserde",
        "libsdv_vpm_api",
    ],
    host_supported: true,
}

rust_test {
    name: "sdv_core_core_services_unit_orch_common_test",
    defaults: ["sdv@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libgoogletest_rust",
        // Orchestrator uses ServiceFqin in tests to mock LM
        "google.sdv.identity-V2-rust",
        "google.sdv.vpm-V1-rust",
        "liblog_rust",
        "libsdv_vpm_api",
        "libserde_test",
        "libserde",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
}
