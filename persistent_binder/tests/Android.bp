aidl_interface {
    name: "google.sdv.persistent_binder.test",
    srcs: ["google/sdv/persistent_binder/test/*.aidl"],
    unstable: true,
    backend: {
        rust: {
            enabled: true,
        },
    },
}

rust_binary {
    name: "persistent_binder_test_service",
    crate_name: "persistent_binder_test_service",
    srcs: [
        "binder_test_service.rs",
    ],
    rustlibs: [
        "google.sdv.persistent_binder.test-rust",
        "libbinder_rs",
        "liblog_rust",
        "libsdv_log_rust",
    ],
    system_ext_specific: true,
}

rust_test {
    name: "sdv_core_core_services_integration_persistent_binder_test",
    srcs: ["persistent_binder_integration_test.rs"],
    rustlibs: [
        "google.sdv.persistent_binder.test-rust",
        "libbinder_rs",
        "libpersistent_binder",
        "libtokio",
    ],
    test_options: {
        unit_test: true,
    },
    require_root: true,
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
}
