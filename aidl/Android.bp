package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

aidl_interface {
    name: "google.sdv.orchestration",
    srcs: ["google/sdv/orchestration/*.aidl"],
    imports: ["google.sdv.identity-V2"],
    system_ext_specific: true,
    unstable: true, // API is SDV internal only
    visibility: [
        // Dependencies to all aidl_interface
        "//system/tools/aidl/build",
        "//system/software_defined_vehicle/health_monitor:__subpackages__",
        "//system/software_defined_vehicle/orchestration:__subpackages__",
    ],
    host_supported: true,
    owner: "google",
    backend: {
        java: {
            enabled: false, // java isn't supported on SDV
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
        rust: {
            enabled: true,
            gen_mockall: true,
            additional_rustlibs: ["libmockall"],
            apex_available: [
                "//apex_available:platform",
                "//apex_available:anyapex",
            ],
        },
    },
}
